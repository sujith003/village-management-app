# Copy this file to .env and fill in real values.
# .env itself is git-ignored and must never be committed.

# A long random string — generate a new one for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of domains this backend will be served from,
# e.g: DJANGO_ALLOWED_HOSTS=your-backend-domain.com,www.your-backend-domain.com
DJANGO_ALLOWED_HOSTS=

# Comma-separated list of frontend origins allowed to call this API,
# e.g: DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of trusted origins for Django admin login (CSRF),
# e.g: DJANGO_CSRF_TRUSTED_ORIGINS=https://your-backend-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# MySQL database connection (default). Set DB_ENGINE=postgresql to
# switch to Postgres instead (e.g. Render's free database tier) —
# then also set DB_PORT=5432 (or leave unset, it defaults correctly).
DB_ENGINE=mysql
DB_NAME=village_festival_db
DB_USER=root
DB_PASSWORD=replace-with-real-password
DB_HOST=localhost
DB_PORT=3306
